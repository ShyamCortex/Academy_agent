# Copy this file to .env and fill it in. .env is git-ignored. Never commit real keys.

# --- API keys (free tiers) ---
# Google AI Studio key (Gemini). GEMINI_API_KEY also works if GOOGLE_API_KEY is not set.
GOOGLE_API_KEY=your_google_ai_studio_key
# Groq key (the judge model)
GROQ_API_KEY=your_groq_key

# --- Which model does which job ---
# Format: <provider>:<model id>      providers: google_genai, groq
# Take the model ids from the official docs (https://ai.google.dev/gemini-api/docs/models and
# https://console.groq.com/docs/models), or run:  python -m email_assistant.model_check --list
# TRIAGE_MODEL: a small, fast Gemini Flash-Lite model.   e.g. google_genai:<flash-lite model id>
# AGENT_MODEL:  a Gemini Flash model (drafting, tool use, memory update).   e.g. google_genai:<flash model id>
# JUDGE_MODEL:  a model from a DIFFERENT family than AGENT_MODEL (a model must not grade its own answers).   e.g. groq:<open model id>
#               Evals refuse to start if JUDGE_MODEL and AGENT_MODEL are the same model.
TRIAGE_MODEL=
AGENT_MODEL=
JUDGE_MODEL=

# --- Rate-limit retry (free tiers answer HTTP 429 when you go too fast) ---
# Optional; these are the defaults.
# MODEL_MAX_RETRIES=6
# MODEL_RETRY_INITIAL_SECONDS=2
# MODEL_RETRY_MAX_SECONDS=60

# --- Test Supabase project (read-only) ---
# A SEPARATE free project, seeded by supabase/academy_test_schema.sql. NEVER the real EduChess project.
# Settings > API in the Supabase dashboard. Use the anon / publishable key ONLY, never a service key.
ACADEMY_SUPABASE_URL=
ACADEMY_SUPABASE_ANON_KEY=

# --- Google test calendar ---
# Calendar settings > "Integrate calendar" > Calendar ID, of a TEST calendar (not a personal one).
GOOGLE_CALENDAR_ID=
# Where the OAuth client file and the saved sign-in live (both git-ignored). These are the defaults.
# GOOGLE_CREDENTIALS_FILE=.secrets/academy_google_credentials.json
# GOOGLE_TOKEN_FILE=.secrets/academy_google_token.json

# --- FAQ search (light RAG): a free local embedding model, no API key ---
# Must give 384 numbers per text (the database column is vector(384)). The first use downloads about 70 MB.
# The same model must be used by the loader and by the agent. List the models fastembed supports:
#   uv run python -c "from fastembed import TextEmbedding as T; print([m['model'] for m in T.list_supported_models() if m['dim'] == 384])"
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional: keep the downloaded model in a folder that is not cleaned up (the default is a temp folder).
# FASTEMBED_CACHE_PATH=.cache/fastembed

# --- FAQ loader: LAPTOP ONLY. Only scripts/ingest_faq.py reads this; the agent never does. ---
# The TEST project's own service_role / secret key (Settings > API). Never the EduChess project. Never in a cloud session.
# ACADEMY_FAQ_LOADER_KEY=

# --- Eval cost (optional): US dollars per million tokens, copied from the provider's pricing page ---
# Free tiers cost nothing; with these set, the results table also shows what the same tokens would cost.
# EVAL_PRICE_TRIAGE_IN=
# EVAL_PRICE_TRIAGE_OUT=
# EVAL_PRICE_AGENT_IN=
# EVAL_PRICE_AGENT_OUT=
# EVAL_PRICE_JUDGE_IN=
# EVAL_PRICE_JUDGE_OUT=

# --- Approved replies are written here instead of being emailed (git-ignored). This is the default. ---
# ACADEMY_OUTBOX_FILE=outbox/academy_outbox.jsonl

# --- MCP: set to 1 to call the read-only tools through the MCP server instead of in-process ---
# USE_MCP=0

# --- LangSmith tracing ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT="academy-support-agent"

# --- Only for the upstream tutorial notebooks in notebooks/ (they still use OpenAI) ---
# OPENAI_API_KEY=your_openai_api_key
