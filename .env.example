# Copy this file to .env and fill it in. .env is git-ignored. Never commit real keys.

# --- API keys (free tiers) ---
# Google AI Studio key (Gemini). GEMINI_API_KEY also works if GOOGLE_API_KEY is not set.
GOOGLE_API_KEY=your_google_ai_studio_key
# Groq key (the judge model)
GROQ_API_KEY=your_groq_key

# --- Which model does which job ---
# Format: <provider>:<model id>      providers: google_genai, groq
# Take the model ids from the official docs (https://ai.google.dev/gemini-api/docs/models and
# https://console.groq.com/docs/models), or run:  python -m email_assistant.model_check --list
# TRIAGE_MODEL: a small, fast Gemini Flash-Lite model.   e.g. google_genai:<flash-lite model id>
# AGENT_MODEL:  a Gemini Flash model (drafting, tool use, memory update).   e.g. google_genai:<flash model id>
# JUDGE_MODEL:  an open model on Groq, NOT Google, so the judge is a different family from the agent.   e.g. groq:<open model id>
TRIAGE_MODEL=
AGENT_MODEL=
JUDGE_MODEL=

# --- Rate-limit retry (free tiers answer HTTP 429 when you go too fast) ---
# Optional; these are the defaults.
# MODEL_MAX_RETRIES=6
# MODEL_RETRY_INITIAL_SECONDS=2
# MODEL_RETRY_MAX_SECONDS=60

# --- LangSmith tracing ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT="academy-support-agent"

# --- Only for the upstream tutorial notebooks in notebooks/ (they still use OpenAI) ---
# OPENAI_API_KEY=your_openai_api_key
